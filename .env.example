# Copy this file to ".env" (cp .env.example .env) and adjust. Never commit the real .env file.
# 1 = local development mode (a random dev secret key is generated automatically).
FLASK_DEBUG=1
# REQUIRED when FLASK_DEBUG is not 1. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Set to 1 only when the site is served over HTTPS.
COOKIE_SECURE=0
# Optional demo password used by seed.py (a random one is printed if empty).
SEED_PASSWORD=
# Optional real e-mail sending. If SMTP_HOST is empty, e-mails are only written to logs/emails.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
